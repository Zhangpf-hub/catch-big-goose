{
  "//": "仅用于命令行类型检查，不参与 Cocos 构建。Cocos 的构建管线只做转译、不做类型检查，",
  "//2": "所以「能构建成功」不等于「类型正确」——本工程曾因此漏掉一次误删（ContainerBoundary.respawn",
  "//3": "被连带删除，构建照过，直到实机点道具才会炸）。改完代码请跑：",
  "//4": "  npx --yes --registry=https://registry.npmjs.org -p typescript@5.6.3 tsc --noEmit -p game/tsconfig.check.json",
  "//5": "registry 必须显式指公共源：本机 npm 默认走内网镜像，取 typescript 会 502。",
  "//6": "target 保持 ES2015 以贴合构建转译，lib 用 ES2017 描述浏览器实际具备的 padStart/includes。",
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["ES2017", "DOM"],
    "module": "ES2015",
    "moduleResolution": "node",
    "strict": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "./temp/declarations/cc.custom-macro",
      "./temp/declarations/cc",
      "./temp/declarations/jsb",
      "./temp/declarations/cc.env"
    ],
    "paths": {
      "db://assets/*": ["./assets/*"]
    }
  },
  "include": ["assets/scripts/**/*.ts"]
}
